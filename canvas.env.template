# Server: which Canvas instance to proxy (required in production).
# CANVAS_API_URL must end with /api/v1 (include the version number).
#
# Users paste their personal access token in the app (Settings). It is kept in
# the browser only. Optional CANVAS_API_TOKEN here is a dev fallback when you
# do not want to enter a token in the UI.

CANVAS_API_URL=https://canvas.example.edu/api/v1
# CANVAS_API_TOKEN=optional-dev-only-fallback

# Data Storyteller — HKUST GenAI API (OpenAI-compatible gateway).
# Subscribe at https://hkust.developer.azure-api.net/ (HKUST GenAI product).
# Users can paste their key in Settings instead; it is kept in the browser only.
#
# HKUST_GENAI_API_KEY=
# HKUST_GENAI_BASE_URL=https://hkust.azure-api.net/hkust-genai/v1
# HKUST_GENAI_MODEL=gpt-4o-mini
